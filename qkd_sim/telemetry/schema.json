{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qkd-sim.local/telemetry.schema.json",
  "title": "Tracking telemetry record (I2)",
  "description": "One record per camera frame, published by tracking on port 5556. Units are in the field names. Nullable fields may be null when not measured.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "t",
    "state",
    "rig",
    "err_x_urad",
    "err_y_urad",
    "residual_mrad",
    "drift_mrad",
    "jitter_mrad",
    "gimbal_lag_mrad",
    "lean_deg",
    "range_m",
    "intensity",
    "exposure_gain",
    "spot_fwhm_px",
    "snr",
    "saturated",
    "latency_ms",
    "gimbal_pan_deg",
    "gimbal_tilt_deg"
  ],
  "properties": {
    "t": {
      "type": "number",
      "description": "Frame capture time, s (sim time in simulation)"
    },
    "state": {
      "enum": [
        "SEARCH",
        "ACQUIRE",
        "TRACK",
        "COAST"
      ]
    },
    "rig": {
      "enum": [
        "rig_fixed",
        "rig_gimbal"
      ]
    },
    "err_x_urad": {
      "type": "number"
    },
    "err_y_urad": {
      "type": "number"
    },
    "residual_mrad": {
      "type": "number"
    },
    "drift_mrad": {
      "type": "number"
    },
    "jitter_mrad": {
      "type": "number"
    },
    "gimbal_lag_mrad": {
      "type": [
        "number",
        "null"
      ]
    },
    "lean_deg": {
      "type": [
        "number",
        "null"
      ]
    },
    "range_m": {
      "type": [
        "number",
        "null"
      ]
    },
    "intensity": {
      "type": "number"
    },
    "exposure_gain": {
      "type": "number"
    },
    "spot_fwhm_px": {
      "type": "number"
    },
    "snr": {
      "type": "number"
    },
    "saturated": {
      "type": "boolean"
    },
    "latency_ms": {
      "type": "number"
    },
    "gimbal_pan_deg": {
      "type": "number"
    },
    "gimbal_tilt_deg": {
      "type": "number"
    },
    "spot_u_px": {
      "type": [
        "number",
        "null"
      ],
      "description": "Optional: measured LED centroid, image x (px, full-resolution delivered frame); null without a spot"
    },
    "spot_v_px": {
      "type": [
        "number",
        "null"
      ],
      "description": "Optional: measured LED centroid, image y (px); null without a spot"
    }
  },
  "examples": [
    {
      "t": 12.508,
      "state": "TRACK",
      "rig": "rig_gimbal",
      "err_x_urad": 412.0,
      "err_y_urad": -187.0,
      "residual_mrad": 0.45,
      "drift_mrad": 3.1,
      "jitter_mrad": 0.8,
      "gimbal_lag_mrad": 0.3,
      "lean_deg": null,
      "range_m": 3.05,
      "intensity": 0.92,
      "exposure_gain": 1.4,
      "spot_fwhm_px": 4.2,
      "snr": 31.0,
      "saturated": false,
      "latency_ms": 152.0,
      "gimbal_pan_deg": 12.31,
      "gimbal_tilt_deg": 4.05
    }
  ]
}
